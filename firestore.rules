rules_version = '2';

// ownerInvites/{lowercaseEmail}: pendingStoreId identifies the invitation's store.
// Accepting it clears pendingStoreId and records the same ID in usedStoreId.
// The optional revoked boolean controls access without changing either store ID.
// The optional accountConfirmed marker records a verified sign-in by the matching email.
// access/{lowercaseEmail}: legacy storeId and active fields support existing store owners.
// The optional legacy revoked marker applies until an owner invitation exists.
// restaurants/{id}: ownerEmail identifies the owner and ownerActive controls store availability.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function email() { return request.auth.token.email.lower(); }
    function admin() { return verified() && email() == 'malekshahbien@gmail.com'; }
    function storePath(id) {
      return /databases/$(database)/documents/restaurants/$(id);
    }
    function invitePath(address) {
      return /databases/$(database)/documents/ownerInvites/$(address);
    }
    function legacyAccessPath(address) {
      return /databases/$(database)/documents/access/$(address);
    }
    function assigned(id) {
      let path = legacyAccessPath(email());
      return exists(path) && get(path).data.active == true && get(path).data.storeId == id;
    }
    function invitationAllowsAccess() {
      let path = invitePath(email());
      let legacy = legacyAccessPath(email());
      return admin() || (exists(path)
        ? get(path).data.get('revoked', false) == false
        : (!exists(legacy) || get(legacy).data.get('revoked', false) != true));
    }
    function ownerEnabled(id, store) {
      // Older stores use their owner's existing access grant until an admin sets ownerActive.
      return invitationAllowsAccess()
        && (store.get('ownerActive', null) == true
          || (store.get('ownerActive', null) == null && (admin() || assigned(id))));
    }
    function accessStore(id) {
      return verified() && canUseStore(id, get(storePath(id)).data);
    }
    function canUseStore(id, store) {
      return store.ownerEmail == email() && ownerEnabled(id, store);
    }
    function validStore(store) {
      return store.keys().hasOnly(['name', 'ownerEmail', 'ownerActive'])
        && store.name is string && store.name.size() > 0 && store.name.size() <= 100
        && store.ownerEmail is string && store.ownerEmail == store.ownerEmail.lower()
        && (!('ownerActive' in store) || store.ownerActive is bool);
    }
    function consumesApproval(id, store) {
      let approval = invitePath(email());
      return store.ownerEmail == email() && store.ownerActive == true
        && get(approval).data.get('revoked', false) == false
        && get(approval).data.pendingStoreId == id
        && getAfter(approval).data.pendingStoreId == ''
        && getAfter(approval).data.usedStoreId == id;
    }
    function validStoreId(id) {
      return id is string && id.size() > 0 && id.size() <= 1500 && id.matches('[^/]+');
    }
    function validInvitation(invitation) {
      return invitation.keys().hasOnly(['pendingStoreId', 'usedStoreId', 'revoked', 'accountConfirmed'])
        && invitation.get('revoked', false) is bool
        && invitation.get('accountConfirmed', true) == true
        && ((validStoreId(invitation.pendingStoreId) && !('usedStoreId' in invitation))
          || (invitation.pendingStoreId == '' && validStoreId(invitation.get('usedStoreId', ''))));
    }
    function createsApprovedStore(address) {
      let id = resource.data.pendingStoreId;
      let path = storePath(id);
      return verified() && email() == address
        && validStoreId(id)
        && resource.data.get('revoked', false) == false
        && !('usedStoreId' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingStoreId', 'usedStoreId'])
        && request.resource.data.pendingStoreId == ''
        && request.resource.data.usedStoreId == id
        && !exists(path) && getAfter(path).data.ownerEmail == address;
    }
    function confirmsOwnAccount(address) {
      return verified() && email() == address
        && resource.data.get('revoked', false) == false
        && !('accountConfirmed' in resource.data)
        && request.resource.data.accountConfirmed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountConfirmed']);
    }
    match /ownerInvites/{address} {
      allow get: if admin() || (verified() && email() == address);
      allow list: if admin();
      allow create: if admin()
        && validInvitation(request.resource.data)
        && request.resource.data.pendingStoreId.size() == 20
        && request.resource.data.get('revoked', false) == false
        && !('accountConfirmed' in request.resource.data)
        && address.size() <= 254 && address.matches('[^@/]+@[^@/]+')
        && address == address.lower() && address != email();
      allow update: if validInvitation(request.resource.data)
        && ((admin() && address != email()
            && request.resource.data.revoked is bool
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']))
          || createsApprovedStore(address)
          || confirmsOwnAccount(address));
    }
    match /profiles/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
    }
    match /access/{address} {
      allow get: if admin() || (verified() && email() == address);
      allow list: if admin();
      allow update: if admin() && address != email()
        && resource.data.get('revoked', false) != true
        && request.resource.data.revoked == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']);
    }
    match /restaurants/{id} {
      allow get: if accessStore(id);
      allow list: if verified() && resource.data.ownerEmail == email();
      allow create: if validStore(request.resource.data)
        && verified() && !admin() && consumesApproval(id, request.resource.data);
      allow update: if verified()
        && resource.data.ownerEmail == email()
        && ownerEnabled(id, resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validStore(request.resource.data);
      match /ledgers/main {
        allow read: if accessStore(id);
        allow create, update: if accessStore(id)
          && request.resource.data.keys().hasOnly(['revision','parts'])
          && request.resource.data.revision is string && request.resource.data.parts is int
          && request.resource.data.parts >= 1 && request.resource.data.parts <= 160;
        match /parts/{part} {
          allow read, delete: if accessStore(id);
          allow create, update: if accessStore(id)
            && request.resource.data.keys().hasOnly(['text','revision'])
            && request.resource.data.text is string && request.resource.data.revision is string;
        }
      }
    }
  }
}
