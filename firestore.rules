rules_version = '2';

// ownerInvites/{lowercaseEmail}: pendingStoreId identifies the invitation's store.
// Accepting it clears pendingStoreId and records the same ID in usedStoreId.
// Approved and unrevoked invitations bind to the verified account's UID once per approval.
// Only a verified sign-in can set accountConfirmed for the current approval.
// profileEstablished records that profiles/{accountUid} exists with a saved name.
// access/{lowercaseEmail}: legacy access history reviewed by the administrator.
// restaurants/{id}: ownerEmail identifies the owner and ownerActive controls store availability.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function email() { return request.auth.token.email.lower(); }
    function admin() { return verified() && email() == 'malekshahbien@gmail.com'; }
    function storePath(id) {
      return /databases/$(database)/documents/restaurants/$(id);
    }
    function invitePath(address) {
      return /databases/$(database)/documents/ownerInvites/$(address);
    }
    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }
    function approvalIsActive(approval) {
      return approval.get('approved', false) == true && approval.get('revoked', false) == false;
    }
    function approvalBelongsToAccount(approval) {
      return approvalIsActive(approval) && approval.get('accountConfirmed', false) == true
        && approval.get('accountUid', '') == request.auth.uid
        && (!approval.get('profileEstablished', false) || exists(profilePath(request.auth.uid)));
    }
    function hasBoundApproval() {
      let path = invitePath(email());
      return !deletionPending(email()) && exists(path) && approvalBelongsToAccount(get(path).data);
    }
    function hasAppAccess() {
      return verified() && (admin() || hasBoundApproval());
    }
    function accessStore(id) {
      return hasAppAccess() && ownsEnabledStore(get(storePath(id)).data);
    }
    function ownsEnabledStore(store) {
      return store.ownerEmail == email() && store.get('ownerActive', null) in [null, true];
    }
    function validStore(store) {
      return store.keys().hasOnly(['name', 'ownerEmail', 'ownerActive'])
        && store.name is string && store.name.size() > 0 && store.name.size() <= 100
        && store.ownerEmail is string && store.ownerEmail == store.ownerEmail.lower()
        && (!('ownerActive' in store) || store.ownerActive is bool);
    }
    function consumesApproval(id, store) {
      let approval = invitePath(email());
      return store.ownerEmail == email() && store.ownerActive == true
        && get(approval).data.pendingStoreId == id
        && getAfter(approval).data.pendingStoreId == ''
        && getAfter(approval).data.usedStoreId == id;
    }
    function validStoreId(id) {
      return id is string && id.size() > 0 && id.size() <= 1500 && id.matches('[^/]+');
    }
    function validInvitation(invitation) {
      let uid = invitation.get('accountUid', '');
      return invitation.keys().hasOnly(['pendingStoreId', 'usedStoreId', 'revoked', 'accountConfirmed', 'approved', 'accountUid', 'profileEstablished'])
        && (!('profileEstablished' in invitation) || (invitation.profileEstablished == true
          && invitation.get('accountConfirmed', false) == true && 'accountUid' in invitation))
        && invitation.get('revoked', false) is bool
        && invitation.get('accountConfirmed', true) == true
        && invitation.get('approved', true) == true
        && (!('accountUid' in invitation) || (invitation.get('approved', false) == true
          && uid is string && uid.size() > 0 && uid.size() <= 128))
        && ((validStoreId(invitation.pendingStoreId) && !('usedStoreId' in invitation))
          || (invitation.pendingStoreId == '' && validStoreId(invitation.get('usedStoreId', ''))));
    }
    function createsApprovedStore(address) {
      let id = resource.data.pendingStoreId;
      let path = storePath(id);
      return verified() && email() == address
        && validStoreId(id)
        && approvalBelongsToAccount(resource.data)
        && !('usedStoreId' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingStoreId', 'usedStoreId'])
        && request.resource.data.pendingStoreId == ''
        && request.resource.data.usedStoreId == id
        && !exists(path) && getAfter(path).data.ownerEmail == address;
    }
    function claimsOwnApproval(address) {
      return verified() && email() == address
        && approvalIsActive(resource.data)
        && resource.data.get('accountUid', request.auth.uid) == request.auth.uid
        && request.resource.data.accountUid == request.auth.uid
        && request.resource.data.accountConfirmed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountUid', 'accountConfirmed']);
    }
    function establishesProfile(address) {
      return verified() && email() == address && approvalBelongsToAccount(resource.data)
        && request.resource.data.profileEstablished == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileEstablished'])
        && validProfile(getAfter(profilePath(request.auth.uid)).data);
    }
    function managesApproval(address) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return admin() && address != email()
        && ((after.revoked == true && changed.hasOnly(['revoked']))
          || (!approvalIsActive(before) && after.approved == true && after.revoked == false
            && !after.keys().hasAny(['accountUid', 'accountConfirmed', 'profileEstablished'])
            && changed.hasOnly(['approved', 'revoked', 'accountUid', 'accountConfirmed', 'profileEstablished'])));
    }
    // This path stores no documents. A permitted point lookup signals active approval
    // without exposing the private invitation or accepting queries on approved emails.
    match /signupChecks/{address} {
      allow get: if request.auth == null
        && resource == null
        && address == address.lower() && address.size() <= 254
        && (address == 'malekshahbien@gmail.com'
          || (!deletionPending(address) && exists(invitePath(address)) && approvalIsActive(get(invitePath(address)).data)));
    }

    function deletionPending(address) {
      return exists(/databases/$(database)/documents/accessRevocations/$(address.lower()));
    }
    match /accessRevocations/{address} {
      allow get, list: if admin();
    }
    match /ownerInvites/{address} {
      allow get: if admin() || (verified() && email() == address);
      allow list: if admin();
      allow delete: if admin() && address.lower() != email();
      allow create: if admin() && !deletionPending(address)
        && validInvitation(request.resource.data)
        && request.resource.data.pendingStoreId.size() == 20
        && approvalIsActive(request.resource.data)
        && !request.resource.data.keys().hasAny(['accountConfirmed', 'accountUid'])
        && address.size() <= 254 && address.matches('[^@/]+@[^@/]+')
        && address == address.lower() && address != email();
      allow update: if !deletionPending(address) && validInvitation(request.resource.data)
        && (managesApproval(address)
          || createsApprovedStore(address)
          || claimsOwnApproval(address)
          || establishesProfile(address));
    }
    function validProfile(profile) {
      return profile.keys().hasOnly(['name']) && profile.name is string
        && profile.name.size() > 0 && profile.name.size() <= 60;
    }
    match /profiles/{uid} {
      allow get: if hasAppAccess() && request.auth.uid == uid;
      allow create, update: if hasAppAccess() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && (admin() || getAfter(invitePath(email())).data.get('profileEstablished', false) == true);
    }
    match /access/{address} {
      allow get: if admin();
      allow list: if admin();
      allow delete: if admin() && address.lower() != email();
    }
    match /restaurants/{id} {
      allow get: if hasAppAccess() && ownsEnabledStore(resource.data);
      allow list: if hasAppAccess() && resource.data.ownerEmail == email();
      allow create: if validStore(request.resource.data)
        && ((admin() && id == 'primary-store'
            && request.resource.data.ownerEmail == email()
            && request.resource.data.ownerActive == true)
          || (hasAppAccess() && !admin() && consumesApproval(id, request.resource.data)));
      allow update: if hasAppAccess() && ownsEnabledStore(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validStore(request.resource.data);
      match /ledgers/main {
        allow read: if accessStore(id);
        allow create, update: if accessStore(id)
          && request.resource.data.keys().hasOnly(['revision','parts'])
          && request.resource.data.revision is string && request.resource.data.parts is int
          && request.resource.data.parts >= 1 && request.resource.data.parts <= 160;
        match /parts/{part} {
          function validPart(data) {
            return part.matches('^([0-9]|[1-9][0-9]|1[0-5][0-9])$')
              && data.keys().hasOnly(['text','revision'])
              && data.text is string && data.text.size() <= 60000
              && data.revision is string;
          }
          allow read, delete: if accessStore(id);
          allow create, update: if accessStore(id) && validPart(request.resource.data);
        }
      }
    }
  }
}
