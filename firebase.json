{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "daily-income-tracking",
    "public": ".hosting-build",
    "predeploy": ["node prepare-hosting.cjs"],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "**/*.@(js|html)",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  }
}
